# Copy to .env and set BOT_TOKEN before starting the bot.
BOT_TOKEN=

# Automatic archive refresh is enabled by default at 03:00 UTC.
# An explicitly blank value disables it. Existing blank panel values also win.
DB_UPDATE_TIME=03:00

# On startup catch up a missed daily run OR an import older than this many hours.
# Set 0 to disable startup catch-up (the daily schedule stays enabled).
DB_UPDATE_MAX_AGE_HOURS=24
# Failed refreshes retry after 5 minutes with capped exponential backoff (1 hour).
DB_UPDATE_RETRY_SEC=300
# One refresh (all pipeline stages and import) has a shared two-hour deadline.
DB_UPDATE_TIMEOUT_SEC=7200

# Optional bot overrides (defaults shown)
DB_PATH=archive.db
POLL_SEC=3
LONGPOLL_SEC=25
POLL_BACKOFF_MAX_SEC=300

# Required only for archive download/upload buttons (my.telegram.org).
TELEGRAM_API=
TELEGRAM_HASH=
# Optional account session for larger/Premium uploads.
USER_SESSION_STRING=

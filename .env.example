# Copy to .env and set BOT_TOKEN before starting the bot.
BOT_TOKEN=

# Optional bot settings (defaults shown)
DB_PATH=archive.db
POLL_SEC=3
LONGPOLL_SEC=25
POLL_BACKOFF_MAX_SEC=300

# Optional daily database refresh; blank disables cron.
# Example: 0 3 * * * (daily at 03:00); then run: bash bot.sh cron-install
DB_UPDATE_CRON=

# Optional MTProto upload settings (needed for large-file/user-session uploads)
TELEGRAM_API=
TELEGRAM_HASH=
USER_SESSION_STRING=

# Copy to .env and set BOT_TOKEN before starting the bot.
BOT_TOKEN=

# Optional: set this to update the archive daily while the bot is running.
# 24-hour UTC time, e.g. 03:00. Leave blank to disable daily refresh.
DB_UPDATE_TIME=

# Optional bot overrides (defaults shown)
DB_PATH=archive.db
POLL_SEC=3
LONGPOLL_SEC=25
POLL_BACKOFF_MAX_SEC=300

# Required only for archive download/upload buttons (my.telegram.org).
TELEGRAM_API=
TELEGRAM_HASH=
# Optional account session for larger/Premium uploads.
USER_SESSION_STRING=

# === Bot configuration ===
# Copy this file to .env and fill it in:
#   cp .env.example .env && nano .env

# REQUIRED — token from @BotFather  (archive bot: bot.py)
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Optional (bot.py)
DB_PATH=archive.db
POLL_SEC=3
LONGPOLL_SEC=25
# Network polling failures use exponential backoff capped at 5 minutes.
POLL_BACKOFF_MAX_SEC=300

# Optional: daily archive/database refresh via cron (default disabled).
# Set to a 5-field cron expression, e.g. 0 3 * * * for daily at 03:00.
# Install/update the cron entry: bash bot.sh cron-install
# Remove it: bash bot.sh cron-remove
DB_UPDATE_CRON=

# === MTProto leeching (leech.py) ===
# api_id / api_hash from https://my.telegram.org  (required by leech.py)
TELEGRAM_API=0
TELEGRAM_HASH=

# Optional — an account session (needed to send files above 2 GB).
# Generate it once: python3 generate_session.py
USER_SESSION_STRING=

# Where leech.py sends the files if -c/--chat is not given
LEECH_CHAT=@mychannel
# Download directory (default: ./downloads next to leech.py)
DOWNLOAD_DIR=downloads
# Split threshold before uploading; 2000mb fits a normal account, 4000mb Premium
LEECH_SPLIT_SIZE=2000mb
# Default thumbnail for video/audio uploads
THUMB_PATH=
# 1 = keep downloaded files on disk after upload (default 0: delete them)
KEEP_FILES=0
